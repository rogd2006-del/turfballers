{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "^/$",               "dest": "/frontend/index.html" },
    { "src": "^/login$",          "dest": "/frontend/login.html" },
    { "src": "^/members$",        "dest": "/frontend/members.html" },
    { "src": "^/bookings$",       "dest": "/frontend/bookings.html" },
    { "src": "^/payments$",       "dest": "/frontend/payments.html" },
    { "src": "^/attendance$",     "dest": "/frontend/attendance.html" },
    { "src": "^/(.*\\.html)$",    "dest": "/frontend/$1" },
    { "src": "^/css/(.*)",        "dest": "/frontend/css/$1" },
    { "src": "^/js/(.*)",         "dest": "/frontend/js/$1" },
    { "src": "^/(.*)",            "dest": "/frontend/$1" }
  ]
}
